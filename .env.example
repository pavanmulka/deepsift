# Copy to .env and fill in. .env is git-ignored.

# Long-lived Claude subscription token from `claude setup-token` (lasts ~1 year).
# Without it the server uses whatever `claude` is signed in as on this machine.
CLAUDE_CODE_OAUTH_TOKEN=

# Key your apps send as "Authorization: Bearer ..." (or "api_key" in the body).
# Put the same value in their TAVILY_API_KEY. Leave empty only on 127.0.0.1.
DEEPSIFT_API_KEY=

# Engines tried in order. claude = Claude WebSearch (subscription),
# searxng = your own SearXNG, ddg = DuckDuckGo HTML (free, gets bot-checked under load).
DEEPSIFT_BACKENDS=claude,ddg
# DEEPSIFT_SEARXNG_URL=http://127.0.0.1:8888

# Models (Claude Code aliases). Haiku keeps searches fast and light on your plan limits.
DEEPSIFT_MODEL=haiku
DEEPSIFT_ANSWER_MODEL=haiku
DEEPSIFT_ADVANCED_MODEL=sonnet
DEEPSIFT_RESEARCH_MODEL=opus

# At most this many `claude -p` runs at once (protects plan rate limits).
DEEPSIFT_CLAUDE_CONCURRENCY=3
# Identical searches within this many hours come from the cache (0 = off).
DEEPSIFT_CACHE_HOURS=24
